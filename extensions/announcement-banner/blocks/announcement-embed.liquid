{% if shop.metafields.my_app.announcement.value != blank %}
<div class="announcement-banner" style="
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: #000;
  color: #fff;
  text-align: center;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  line-height: 1.4;
">
  {{ shop.metafields.my_app.announcement.value }}
</div>
{% endif %}
{% schema %}
{
  "name": "Announcement Banner",
  "target": "body",
  "settings": []
}
{% endschema %}
